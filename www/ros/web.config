<?xml version="1.0" encoding="utf-8"?>
<!-- The Reload OS website on the office server's IIS (website/README.md, "The office server"): what Apache's
     os.re-loader.com.conf does. Put at the site's folder by build.py (with - -iis); IIS reads it where it is.
     The MIME types (.wasm, .svg, .json) are the server's own already: adding them again would be an error. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <!-- Try it and Studio run the UI's tasks on threads: a browser allows that on a cross-origin isolated page
             only. Every file here is the site's own, so the headers can cover the whole folder -->
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Embedder-Policy" value="require-corp" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="Custom">
      <remove statusCode="404" />
      <!-- File mode keeps the 404 status (ExecuteURL answered 200 for a static page); the path is from wwwroot -->
      <error statusCode="404" path="ros\404.html" responseMode="File" />
    </httpErrors>
  </system.webServer>
</configuration>
